{
  "name": "@flu-wop/design-system",
  "version": "0.2.0",
  "description": "IN-FLU-ENTIAL design system: tokens, Tailwind preset, base styles and shared React components for every flu-wop site.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./styles.css",
    "./tailwind-preset": "./tailwind-preset.cjs",
    "./tokens.json": "./tokens.json"
  },
  "files": [
    "src",
    "styles.css",
    "tailwind-preset.cjs",
    "tokens.json",
    "scripts",
    "README.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build:css": "node scripts/build-css.mjs",
    "typecheck": "tsc --noEmit",
    "migrate": "node scripts/migrate-colors.mjs"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.0"
  }
}
